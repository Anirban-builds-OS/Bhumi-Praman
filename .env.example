# Copy this file to .env and adjust as needed. .env is git-ignored.
# Lines left commented out use the application's built-in default -- only
# uncomment and set a value if you need to override it.

# --- App ---
APP_NAME=Bhumi Praman
ENV=development

# --- Database ---
# Default: local SQLite file, zero setup. For production, use PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/bhumi_praman
DATABASE_URL=sqlite:///./bhumi_praman.db

# --- Auth ---
# CHANGE THIS before any real deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-secret-change-me-3f8a9c2e1b7d4f6a
ACCESS_TOKEN_EXPIRE_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES_EXTENDED=480
JWT_ALGORITHM=HS256

# --- AI / OCR ---
# Only needed if `tesseract` is not on your PATH. Common Windows default:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=en
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_LOW_THRESHOLD=0.60

# --- Storage ---
# Defaults to <repo-root>/storage automatically. Only set this (to an
# absolute path) if you want uploaded files stored somewhere else:
# STORAGE_PATH=D:\bhumi-praman-storage
MAX_UPLOAD_SIZE_MB=50

# --- CORS ---
# The Vite dev server proxy makes this a non-issue for local dev; only
# needed if the frontend is served from a different origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- GIS (optional) ---
# Not required -- the GIS explorer uses OpenStreetMap tiles, which need no key.
# MAP_API_KEY=
